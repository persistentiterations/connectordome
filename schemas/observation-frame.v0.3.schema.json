{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connectordome.com/schemas/observation-frame.v0.3.schema.json",
  "title": "ConnectorDome Collective Observation Frame v0.3",
  "type": "object",
  "required": ["schema", "frame_id", "frame_revision", "anchor", "request", "observations", "exclusions", "coverage", "reconstruction_notice", "action_authority"],
  "properties": {
    "schema": { "const": "connectordome.observation-frame/v0.3" },
    "frame_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "frame_revision": { "type": "integer", "minimum": 1 },
    "supersedes_frame_id": { "type": ["string", "null"] },
    "anchor": { "type": "object" },
    "request": { "type": "object" },
    "observations": { "type": "array" },
    "exclusions": { "type": "array" },
    "coverage": { "type": "object", "required": ["expected_sources", "represented_sources", "missing_sources", "included_count", "excluded_count", "complete_world_measurement"] },
    "reconstruction_notice": { "type": "string" },
    "simulated_conditions_present": { "type": "boolean" },
    "action_authority": { "const": "NONE" }
  },
  "additionalProperties": true
}
