{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connectordome.com/schemas/formation.v0.1alpha1.schema.json",
  "title": "ConnectorDome experimental formation",
  "type": "object",
  "required": ["formation_version", "formation_id", "correlation_id", "steps"],
  "properties": {
    "formation_version": { "const": "connectordome.formation/v0.1alpha1" },
    "formation_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "endpoint_id", "operation", "authority", "now", "observed_at"],
        "properties": {
          "id": { "type": "string" },
          "endpoint_id": { "type": "string" },
          "operation": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "conflicts_with": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
